      <ComplicationSlot slotId="2" x="216" y="104" width="100" height="30" alpha="255" displayName="date_slot_label"
          supportedTypes="SHORT_TEXT" isCustomizable="FALSE">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <DefaultProviderPolicy defaultSystemProvider="DATE" defaultSystemProviderType="SHORT_TEXT"/>
        <BoundingBox x="0" y="0" width="100" height="30"/>
        <Complication type="SHORT_TEXT">
          <PartText x="0" y="0" width="100" height="30"><Text align="START"><Font family="SYNC_TO_DEVICE" size="22" weight="SEMI_BOLD" color="#FFECEDEF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
        </Complication>
      </ComplicationSlot>

      <!-- heart rate (Samsung Health, Google fallback); slots must be direct children of Scene -->
      <ComplicationSlot slotId="0" x="274" y="180" width="96" height="96" displayName="hr_slot_label"
          supportedTypes="SHORT_TEXT EMPTY" isCustomizable="TRUE">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
        <DefaultProviderPolicy
            defaultSystemProvider="HEART_RATE" defaultSystemProviderType="SHORT_TEXT"
            primaryProvider="com.samsung.android.wear.shealth/com.samsung.android.wear.shealth.complications.heartrate.HeartrateComplicationProviderService"
            primaryProviderType="SHORT_TEXT"/>
        <BoundingOval x="0" y="0" width="96" height="96"/>
        <Complication type="SHORT_TEXT">
          <!-- ECG sweep in the background (Customise "Pulse animation", ~10 % CPU while the screen is on) -->
          <Group name="pulse_bg" x="0" y="0" width="96" height="96">
            <BooleanConfiguration id="heartAnim">
              <BooleanOption id="TRUE">
                <Group name="pulse_anim" x="0" y="0" width="96" height="96">
                  <PartAnimatedImage x="6" y="36" width="84" height="34">
                    <AnimationController play="ON_VISIBLE TAP" repeat="TRUE" beforePlaying="FIRST_FRAME" afterPlaying="FIRST_FRAME"/>
                    <SequenceImages loopCount="1" frameRate="12"><Image resource="pulse_f00"/><Image resource="pulse_f01"/><Image resource="pulse_f02"/><Image resource="pulse_f03"/><Image resource="pulse_f04"/><Image resource="pulse_f05"/><Image resource="pulse_f06"/><Image resource="pulse_f07"/><Image resource="pulse_f08"/><Image resource="pulse_f09"/><Image resource="pulse_f10"/><Image resource="pulse_f11"/><Image resource="pulse_f12"/><Image resource="pulse_f13"/><Image resource="pulse_f14"/><Image resource="pulse_f15"/></SequenceImages>
                  </PartAnimatedImage>
                </Group>
              </BooleanOption>
              <BooleanOption id="FALSE">
                <Group name="pulse_still" x="0" y="0" width="96" height="96">
                  <PartImage x="6" y="36" width="84" height="34"><Image resource="pulse_static"/></PartImage>
                </Group>
              </BooleanOption>
            </BooleanConfiguration>
          </Group>
          <PartImage x="34" y="6" width="28" height="28"><Image resource="heart_f00"/></PartImage>
          <PartText x="0" y="33" width="96" height="34">
            <Text align="CENTER">
              <Font family="SYNC_TO_DEVICE" size="27" weight="SEMI_BOLD" color="#FFF2F3F5">
                <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
              </Font>
            </Text>
          </PartText>
          <PartText x="0" y="63" width="96" height="14">
            <Text align="CENTER">
              <Font family="SYNC_TO_DEVICE" size="10" weight="SEMI_BOLD" color="#FFFF8A96" letterSpacing="0.1">BPM</Font>
            </Text>
          </PartText>
        </Complication>
      </ComplicationSlot>

    <Group name="active_front" x="0" y="0" width="450" height="450" alpha="255">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <!-- steps: progress ring + number -->
      <PartDraw x="0" y="0" width="450" height="450">
        <Arc centerX="225" centerY="328" width="88" height="88" startAngle="0" endAngle="360">
          <Stroke color="#FF24272D" thickness="5"/>
        </Arc>
        <Arc centerX="225" centerY="328" width="88" height="88" startAngle="0" endAngle="1">
          <Transform target="endAngle" value="360 * clamp([STEP_PERCENT], 1, 100) / 100"/>
          <Stroke color="[CONFIGURATION.theme.0]" thickness="5" cap="ROUND"/>
        </Arc>
      </PartDraw>
      <PartText x="177" y="304" width="96" height="34">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="24" weight="SEMI_BOLD" color="#FFF2F3F5">
            <Template>%s<Parameter expression="[STEP_COUNT]"/></Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="177" y="336" width="96" height="18">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="11" weight="SEMI_BOLD" color="#FF8C929A" letterSpacing="0.1">STEPS</Font>
        </Text>
      </PartText>

      <!-- hands -->
      <AnalogClock x="0" y="0" width="450" height="450">
        <HourHand resource="hand_hour" x="208" y="97" width="34" height="150" pivotX="0.5" pivotY="0.8533"/>
        <MinuteHand resource="hand_minute" x="212" y="35" width="26" height="214" pivotX="0.5" pivotY="0.8879"/>
      </AnalogClock>
      <BooleanConfiguration id="showSeconds">
        <BooleanOption id="TRUE">
          <AnalogClock x="0" y="0" width="450" height="450">
            <SecondHand resource="hand_second" x="218" y="29" width="14" height="250" pivotX="0.5" pivotY="0.784" tintColor="[CONFIGURATION.theme.0]"/>
          </AnalogClock>
        </BooleanOption>
      </BooleanConfiguration>
      <!-- centre cap -->
      <PartDraw x="209" y="209" width="32" height="32">
        <Ellipse x="0" y="0" width="32" height="32">
          <Fill color="[CONFIGURATION.theme.0]"/>
        </Ellipse>
        <Ellipse x="10" y="10" width="12" height="12">
          <Fill color="#FF111214"/>
        </Ellipse>
      </PartDraw>
    </Group>

    <!-- ================= AOD: bold bright analog + Mumbai ================= -->
    <Group name="aod" x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255"/>
      <PartImage x="0" y="0" width="450" height="450" tintColor="[CONFIGURATION.theme.0]">
        <Image resource="dial_aod"/>
      </PartImage>
      <!-- glass day-date window near 3 o'clock; its text comes from complication slots 3 + 4 -->
      <PartDraw x="258" y="204" width="134" height="42">
        <RoundRectangle x="0" y="0" width="134" height="42" cornerRadiusX="11" cornerRadiusY="11"><Fill color="#E6101114"/></RoundRectangle>
        <RoundRectangle x="0" y="0" width="134" height="42" cornerRadiusX="11" cornerRadiusY="11">
          <Fill color="#10FFFFFF"><LinearGradient startX="0" startY="0" endX="0" endY="42" colors="#26FFFFFF #06FFFFFF" positions="0 1"/></Fill>
          <Stroke color="[CONFIGURATION.theme.0]" thickness="2"><LinearGradient startX="0" startY="0" endX="0" endY="42" colors="[CONFIGURATION.theme.0] [CONFIGURATION.theme.1]" positions="0 1"/></Stroke>
        </RoundRectangle>
      </PartDraw>
      <PartText x="0" y="292" width="450" height="18">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="13" weight="SEMI_BOLD" color="[CONFIGURATION.theme.0]" letterSpacing="0.1">MUMBAI</Font>
        </Text>
      </PartText>
      <DigitalClock x="0" y="0" width="450" height="450">
        <Localization timeZone="Asia/Kolkata"/>
        <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="151" y="308" width="150" height="32">
          <Font family="SYNC_TO_DEVICE" size="26" weight="MEDIUM" color="#FFFFFFFF"/>
        </TimeText>
      </DigitalClock>
      <!-- Mumbai am/pm as a clock element (offloadable): hh (24 h) in Asia/Kolkata drawn by the mumbai_ampm bitmap font -->
      <DigitalClock x="0" y="0" width="450" height="450">
        <Localization timeZone="Asia/Kolkata"/>
        <TimeText format="hh" hourFormat="24" align="START" x="265" y="316" width="44" height="22">
          <BitmapFont family="mumbai_ampm" size="22" color="[CONFIGURATION.theme.0]"/>
        </TimeText>
      </DigitalClock>
      <!-- orange hour hand; white minute hand carrying an orange rim dot that travels with the minutes -->
      <AnalogClock x="0" y="0" width="450" height="450">
        <HourHand resource="aod_hour" x="210" y="97" width="30" height="150" pivotX="0.5" pivotY="0.8533" tintColor="[CONFIGURATION.theme.0]"/>
        <MinuteHand resource="aod_minute" x="213" y="1" width="24" height="232" pivotX="0.5" pivotY="0.9655"/>
      </AnalogClock>
      <AnalogClock x="0" y="0" width="450" height="450">
        <MinuteHand resource="aod_minute_dot" x="213" y="1" width="24" height="232" pivotX="0.5" pivotY="0.9655" tintColor="[CONFIGURATION.theme.0]"/>
      </AnalogClock>
      <PartDraw x="213" y="213" width="24" height="24">
        <Ellipse x="0" y="0" width="24" height="24">
          <Fill color="[CONFIGURATION.theme.0]"/>
        </Ellipse>
        <Ellipse x="8" y="8" width="8" height="8">
          <Fill color="#FF000000"/>
        </Ellipse>
      </PartDraw>
    </Group>
      <!-- AOD day-date window text (fixed system complications, drawn above the AOD group) -->
      <ComplicationSlot slotId="3" x="263" y="209" width="46" height="32" alpha="0" displayName="date_slot_label"
          supportedTypes="SHORT_TEXT" isCustomizable="FALSE">
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <DefaultProviderPolicy defaultSystemProvider="DAY_OF_WEEK" defaultSystemProviderType="SHORT_TEXT"/>
        <BoundingBox x="0" y="0" width="46" height="32"/>
        <Complication type="SHORT_TEXT">
          <PartText x="0" y="0" width="46" height="32"><Text align="END"><Font family="SYNC_TO_DEVICE" size="19" weight="SEMI_BOLD" color="[CONFIGURATION.theme.0]"><Upper><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Upper></Font></Text></PartText>
        </Complication>
      </ComplicationSlot>
      <ComplicationSlot slotId="4" x="315" y="209" width="72" height="32" alpha="0" displayName="date_slot_label"
          supportedTypes="SHORT_TEXT" isCustomizable="FALSE">
        <Variant mode="AMBIENT" target="alpha" value="255"/>
        <DefaultProviderPolicy defaultSystemProvider="DATE" defaultSystemProviderType="SHORT_TEXT"/>
        <BoundingBox x="0" y="0" width="72" height="32"/>
        <Complication type="SHORT_TEXT">
          <PartText x="0" y="0" width="72" height="32"><Text align="START"><Font family="SYNC_TO_DEVICE" size="19" weight="SEMI_BOLD" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
        </Complication>
      </ComplicationSlot>
  </Scene>
</WatchFace>
